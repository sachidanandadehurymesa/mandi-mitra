# Copy this file to .env.local and fill in what you have. Everything here is
# OPTIONAL — Mandi Mitra runs end-to-end on demo data with none of these set.

# --- Admin dashboard (demo auth) ---------------------------------------------
# Password gating /admin. If unset, a demo fallback password is used and shown
# on the login screen — set this before any real pilot.
ADMIN_PASSWORD=

# --- Agmarknet / data.gov.in market data (not yet implemented) --------------
# See src/lib/market/provider.ts. Until both are set, the app uses the
# bundled demo dataset for every price.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=

# --- AI assistant (not yet implemented) --------------------------------------
# See src/lib/ai/assistant.ts. Until set, the app uses a rule-based mock
# assistant instead of calling Claude.
ANTHROPIC_API_KEY=

# --- WhatsApp Business Cloud API (not yet implemented) -----------------------
# See src/lib/whatsapp/service.ts. There is no webhook route yet — these are
# placeholders for when one is added.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Supabase (not yet connected) --------------------------------------------
# See supabase/migrations and supabase/seed.sql for the intended schema.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
